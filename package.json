{
  "name": "cw-realty",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/build-photo-encoder.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-photo-encoder.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "SUPABASE_AUTH_CAPTCHA_SECRET=${SUPABASE_AUTH_CAPTCHA_SECRET:-1x0000000000000000000000000000000AA} supabase start -x studio,imgproxy,vector,logflare,edge-runtime,supavisor",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --schema cwr --level warning --fail-on warning",
    "db:check": "node scripts/check-migrations.mjs",
    "design:check": "node scripts/check-design-tokens.mjs",
    "admin:invite": "node scripts/invite-admin.mjs",
    "content:import": "node scripts/import-live-site-content.mjs",
    "content:import:local": "eval \"$(supabase status -o env --override-name api.url=SUPABASE_URL --override-name auth.service_role_key=SUPABASE_SERVICE_ROLE_KEY)\" && export SUPABASE_URL SUPABASE_SERVICE_ROLE_KEY && node scripts/import-live-site-content.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@jsquash/avif": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "@marsidev/react-turnstile": "1.6.1",
    "@opennextjs/cloudflare": "1.20.6",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "otpauth": "9.5.2",
    "sharp": "0.35.4",
    "supabase": "2.118.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.2",
    "wrangler": "4.140.0"
  }
}
