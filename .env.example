# Copy to .env.local for local development. Never commit real values.
# Production values live in Cloudflare Workers secrets and GitHub Actions secrets.

# Public (safe to expose to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Chat assistant (Claude). Without it, chat hands every question to a person.
ANTHROPIC_API_KEY=
