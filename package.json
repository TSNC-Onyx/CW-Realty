{
  "name": "cw-realty",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/build-photo-encoder.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-photo-encoder.mjs",
    "build": "next build",
    "postbuild": "node scripts/hide-browser-source-maps.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "SUPABASE_AUTH_CAPTCHA_SECRET=${SUPABASE_AUTH_CAPTCHA_SECRET:-1x0000000000000000000000000000000AA} supabase start -x studio,imgproxy,vector,logflare,supavisor",
    "worker:check": "cd supabase/functions/email-worker && npx --yes deno@2.7.14 check index.ts && npx --yes deno@2.7.14 lint",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --schema cwr --level warning --fail-on warning",
    "db:check": "node scripts/check-migrations.mjs",
    "db:catalog": "node scripts/check-problem-catalog.mts",
    "errors:check": "node scripts/check-error-handling.mts",
    "design:check": "node scripts/check-design-tokens.mjs",
    "email:templates": "EMAIL_WRITE=1 vitest run supabase/functions/email-worker/email-files.test.ts",
    "email:preview": "EMAIL_PREVIEW=1 vitest run supabase/functions/email-worker/email-files.test.ts",
    "admin:invite": "node scripts/invite-admin.mjs",
    "content:import": "node scripts/import-live-site-content.mjs",
    "photos:site": "node scripts/build-site-photos.mjs",
    "content:import:local": "eval \"$(supabase status -o env --override-name api.url=SUPABASE_URL --override-name auth.service_role_key=SUPABASE_SERVICE_ROLE_KEY)\" && export SUPABASE_URL SUPABASE_SERVICE_ROLE_KEY && node scripts/import-live-site-content.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "postinstall": "node scripts/patch-opennext-sourcemap.mjs",
    "release:build": "node scripts/patch-opennext-sourcemap.mjs --strict && opennextjs-cloudflare build && node scripts/store-source-maps.mjs",
    "problem:trace": "node --experimental-strip-types scripts/trace-problem.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@jridgewell/trace-mapping": "0.3.31",
    "@jsquash/avif": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "@marsidev/react-turnstile": "1.6.3",
    "@opennextjs/cloudflare": "1.20.14",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "otpauth": "9.5.2",
    "sharp": "0.35.5",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
