{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cw-realty",
  // Custom entry: the Next.js app plus the alert-email queue consumers (worker.ts).
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cw-realty"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "upload_source_maps": true,
  // Public project URL for the queue consumer (the site itself uses NEXT_PUBLIC_SUPABASE_URL).
  // Previews and production share this one Supabase project; change both together.
  // Plain variables live here, not in the dashboard: every deploy replaces dashboard
  // variables with this list (secrets are kept).
  "vars": {
    "SUPABASE_URL": "https://egadvqpatnlkvgiiszzx.supabase.co",
    "ALERT_FROM_EMAIL": "alerts@notify.charliewardrealty.com",
    "ALERT_FROM_NAME": "CWR website"
  },
  // Public form posts: at most 5 per visitor per minute (Infra §2).
  "ratelimits": [{ "name": "FORM_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  // Alert emails: retried with backoff, then parked in a dead-letter queue (Infra §3).
  // Both queues must exist in the Cloudflare account before deploying (runbook).
  "queues": {
    "producers": [{ "binding": "CWR_ALERTS", "queue": "cwr-alerts" }],
    "consumers": [
      { "queue": "cwr-alerts", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "cwr-alerts-dlq" },
      { "queue": "cwr-alerts-dlq", "max_batch_size": 10, "max_retries": 0 }
    ]
  },
  // Preview site for the build1 branch: its own Worker, queues, and rate-limit counters, so
  // it never touches production traffic or alert queues. Deployed by
  // .github/workflows/preview-build1.yml; per-PR previews upload versions to it.
  // Wrangler does not inherit vars, services, queues, or ratelimits into environments,
  // so every binding above is repeated here.
  "env": {
    "preview": {
      "name": "cw-realty-preview",
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "cw-realty-preview" }],
      "vars": {
        "SUPABASE_URL": "https://egadvqpatnlkvgiiszzx.supabase.co",
        "ALERT_FROM_EMAIL": "alerts@notify.charliewardrealty.com",
        "ALERT_FROM_NAME": "CWR website (preview)"
      },
      "ratelimits": [{ "name": "FORM_RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } }],
      "queues": {
        "producers": [{ "binding": "CWR_ALERTS", "queue": "cwr-alerts-preview" }],
        "consumers": [
          { "queue": "cwr-alerts-preview", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "cwr-alerts-preview-dlq" },
          { "queue": "cwr-alerts-preview-dlq", "max_batch_size": 10, "max_retries": 0 }
        ]
      }
    }
  }
}
